{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ViolationCreated",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "cameraId", "violationId", "violationType"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "enum": ["ViolationCreated", "ViolationUpdated", "ViolationResolved"] },
    "schemaVersion": { "const": 1 },
    "cameraId": { "type": "string" },
    "trackId": { "type": "integer" },
    "violationType": { "type": "string" },
    "ppeZone": { "enum": ["OUTSIDE", "SHOCKING"] },
    "isImmediate": { "type": "boolean" },
    "idempotencyKey": { "type": "string" },
    "boundingBoxes": { "type": "array" }
  }
}
